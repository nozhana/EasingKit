":"text"}]}]}],"type":"orderedList"},{"type":"heading","level":3,"text":"Setup the view","anchor":"Setup-the-view"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Create a circle in the middle of the screen.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a boolean state variable to show and hide the circle."}]}]},{"content":[{"inlineContent":[{"text":"Create a button that toggles the state variable.","type":"text"}],"type":"paragraph"}]}]},{"type":"codeListing","code":["struct TransitionTestView: View {","    @State private var showCircle = false","    ","    var body: some View {","        VStack {","            if showCircle {","                Circle()","                    .frame(width: 100, height: 100)","                    .transition(.scale)","            }","            ","            Button(\"Show\/Hide circle\") {","                withAnimation {","                    showCircle.toggle()","                }","            }","        }","    }","}"],"syntax":"swift"},{"type":"heading","level":3,"anchor":"Change-the-animation","text":"Change the animation"},{"inlineContent":[{"type":"text","text":"Change the animation to an "},{"code":"easeInOutCubic","type":"codeVoice"},{"type":"text","text":" animation."}],"type":"paragraph"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"easeInOut"},{"text":" functions work wonders with scale transitions! Just like ","type":"text"},{"code":"easeOut","type":"codeVoice"},{"text":" functions and move transitions.","type":"text"}],"type":"paragraph"}],"name":"Tip","style":"tip"},{"code":["struct TransitionTestView: View {","    @State private var showCircle = false","    ","    var body: some View {","        VStack {","            if showCircle {","                Circle()","                    .frame(width: 100, height: 100)","                    .transition(.scale)","          